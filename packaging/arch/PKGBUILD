# Maintainer: Zalomarchy Contributors <https://github.com/alaireselene/zalo-omarchy>

pkgname=zalomarchy
_pkgname=zalomarchy
pkgver=26.8.20
pkgrel=1
pkgdesc="Zalo desktop client optimized for Wayland, Hyprland, and Omarchy (native package, full feature call engine)"
arch=('x86_64')
url="https://github.com/alaireselene/zalo-omarchy"
license=('MIT')
provides=('zalo' 'zalo-for-linux' 'zalo-bin' 'zalomarchy')
conflicts=('zalo' 'zalo-for-linux' 'zalo-for-linux-bin' 'zalo-bin')

depends=(
    'alsa-lib'
    'at-spi2-atk'
    'atk'
    'cairo'
    'cups'
    'glibc'
    'gtk3'
    'libdrm'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxshmfence'
    'mesa'
    'nss'
    'pango'
    'zlib'
    # Mandatory for 1-click just work (calling, media, Wayland clipboard & screen share)
    'wine'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
    'xorg-server-xvfb'
    'xdotool'
    'python-dbus'
    'wl-clipboard'
)

makedepends=(
    'git'
    'nodejs>=18'
    'npm'
    '7zip'
    'gcc'
    'gcc-libs'
)


install=zalomarchy.install
options=(!strip !debug)

source=(
    "git+https://github.com/alaireselene/zalo-omarchy.git#branch=main"
    "zalomarchy.desktop"
    "zalomarchy.sh"
)

sha256sums=(
    'SKIP'
    '830f857518636d376f0cfe5d6fe511e3a03fb0223e2807d152179245c554df3e'
    '6df1317db1dcdadc1b0939cbf805fe826ac0c52ecea6ae33e54fe60259db4f33'
)

prepare() {
    cd "${srcdir}/zalo-omarchy"
    git submodule update --init --recursive

    # Add ~/.cargo/bin to PATH for builders who installed Rust via rustup script
    if [ -d "$HOME/.cargo/bin" ] && [[ ":$PATH:" != *":$HOME/.cargo/bin:"* ]]; then
        export PATH="$HOME/.cargo/bin:$PATH"
    fi

    if ! command -v cargo >/dev/null 2>&1; then
        echo "==> ERROR: Rust toolchain ('cargo') is required to build native addons." >&2
        echo "    Install via official script: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh" >&2
        echo "    Or via pacman: sudo pacman -S cargo" >&2
        exit 1
    fi
}

build() {
    cd "${srcdir}/zalo-omarchy"

    # Add ~/.cargo/bin to PATH if present
    if [ -d "$HOME/.cargo/bin" ] && [[ ":$PATH:" != *":$HOME/.cargo/bin:"* ]]; then
        export PATH="$HOME/.cargo/bin:$PATH"
    fi

    # 1. Install dependencies
    npm ci --prefer-offline --no-audit

    # 2. Extract macOS DMG, compile native C++ & Rust addons, setup call engine, apply patches
    npm run main:setup

    # 3. Build native Linux directory target (optimized native ELF binaries)
    npx electron-builder --linux dir
}

package() {
    cd "${srcdir}/zalo-omarchy"

    # Install application files to /opt/zalomarchy
    install -dm755 "${pkgdir}/opt/zalomarchy"
    cp -a dist/linux-unpacked/* "${pkgdir}/opt/zalomarchy/"

    # Set proper permissions on binaries and SUID sandbox
    chmod 755 "${pkgdir}/opt/zalomarchy/zalomarchy" 2>/dev/null || chmod 755 "${pkgdir}/opt/zalomarchy/zalo" 2>/dev/null || true
    if [ -f "${pkgdir}/opt/zalomarchy/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/opt/zalomarchy/chrome-sandbox"
    fi

    # Install launcher wrapper to /usr/bin/zalomarchy and symlink /usr/bin/zalo
    install -Dm755 "${srcdir}/zalomarchy.sh" "${pkgdir}/usr/bin/zalomarchy"
    ln -sf /usr/bin/zalomarchy "${pkgdir}/usr/bin/zalo"

    # Install desktop entry
    install -Dm644 "${srcdir}/zalomarchy.desktop" "${pkgdir}/usr/share/applications/zalomarchy.desktop"

    # Install icons for both zalomarchy and zalo
    for icon_name in "zalomarchy.png" "zalo.png"; do
        if [ -f "app/pc-dist/favicon-512x512.png" ]; then
            install -Dm644 "app/pc-dist/favicon-512x512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${icon_name}"
            install -Dm644 "app/pc-dist/favicon-512x512.png" "${pkgdir}/usr/share/pixmaps/${icon_name}"
        fi
    done

    # Install License
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
