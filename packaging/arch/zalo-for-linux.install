post_install() {
    echo ""
    echo "==> Zalo for Linux installed successfully!"
    echo "    - Text messaging, photos, files, and E2EE sync work out of the box."
    echo "    - Voice/Video calls require Wine & GStreamer:"
    echo "        sudo pacman -S --needed wine wine-mono gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav"
    echo "    - Custom flags (Wayland / scaling): ~/.config/zalo-flags.conf"
    echo ""
}

post_upgrade() {
    post_install
}
