	optdepends = mingw-w64-gcc: Build Windows call bridge during source build (voice/video calls)
	optdepends = wl-clipboard: Paste images from clipboard on Wayland
	optdepends = xclip: Paste images from clipboard on X11
	optdepends = wine: Voice/Video call engine support (runs 32-bit ZaloCall via Wine WoW64)
	optdepends = wine-mono: Mono runtime for Wine
	optdepends = gst-plugins-base: GStreamer base plugins for video calling
	optdepends = gst-plugins-good: GStreamer good plugins (video decoders/sinks)
	optdepends = gst-plugins-bad: GStreamer bad plugins for video and Wayland screen capture
	optdepends = gst-libav: H.264 video codec decoding for video calls
	optdepends = v4l-utils: Camera format adjustment utility (fix inverted/green camera)
	optdepends = xorg-server-xvfb: Headless X11 server for Wayland screen-sharing bridge
	optdepends = xdotool: Window geometry helper for Wayland screen sharing
	optdepends = python-dbus: Python D-Bus binding for XDG portal screen capture
	optdepends = flameshot: Screenshot tool integration
	optdepends = spectacle: Screenshot tool integration (KDE Plasma)
	optdepends = gnome-screenshot: Screenshot tool integration (GNOME)
